# ==========================================
# SAPC Course Proposal System - Environment Variables
# IIT Gandhinagar - CS202 Project 13
# ==========================================

# Flask Backend Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-sapc-iitgn-2026
PORT=5000

# Database Configuration (PostgreSQL)
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sapc_db
# In development, if PostgreSQL is not specified, system defaults to SQLite for immediate testing:
DATABASE_URL=sqlite:///sapc_course_proposals.db

# Admin User Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@IITGN2026
ADMIN_EMAIL=academic.office@iitgn.ac.in

# Email / SMTP Configuration
# Set to 'smtp' to send via real SMTP server, or 'local' to record in local outbox/logs
MAIL_BACKEND=local
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@iitgn.ac.in
MAIL_PASSWORD=your_app_password
MAIL_FROM=sapc-academic@iitgn.ac.in
MAIL_SENDER_NAME=SAPC Academic Office, IIT Gandhinagar

# SAPC Office Notification Emails (CC recipients specified in ACAD-SAPC-01)
SAPC_UG_OFFICE_EMAIL=ar.ug@iitgn.ac.in
SAPC_DOAA_EMAIL=doaa@iitgn.ac.in

# PDF Storage Path
PDF_STORAGE_DIR=../generated_pdfs
